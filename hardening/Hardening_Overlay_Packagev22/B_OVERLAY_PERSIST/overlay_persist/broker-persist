#!/bin/bash
__version__="1.0.0.(16) - overlay"
# =====================================================================================================================================
#      OVERLAY
#      Name                       : OVERLAY
#      Version                    : 1.0.0.(16)
#      Date Created               : 11-10-2026
#      Updated                    : 11-10-2026
#      Author                     : Saifuddin
#      Notes                      : broker-persist - root helper (installed in /usr/local/sbin). Copies important files from
#                                   the overlay view to the real SD card (lower layer, /media/root-ro).
# ======================================================================================================================================
#
# The real SD card is opened for writing for only a few milliseconds, then locked again.
#
# Accepted arguments (nothing else):
#   config.json          -> copy config.json
#   conf.d/bridge.conf   -> copy bridge.conf + /etc/hostname + the eth0 network profile
#   network              -> copy only the eth0 network profile (the /etc/netplan/*.yaml that defines eth0)
#
# eth0 network profile: nmcli/NetworkManager stores the static eth0 IP in /etc/netplan/90-NM-*.yaml.
# With the overlay that file lives only in RAM. This script copies it to the real SD card so the Pi
# boots directly with the DIP-switch IP (never with the temporary image IP). The wifi (wlan0) YAML is NOT touched.
#
# Environment variables (for testing): BROKER, LOWER, HOSTNAME_FILE, NETPLAN_DIR,
#                                      BROKER_PERSIST_FORCE=1, BROKER_PERSIST_NOMOUNT=1
set -u
BROKER="${BROKER:-/home/alice/broker}"
LOWER="${LOWER:-/media/root-ro}"
HOSTNAME_FILE="${HOSTNAME_FILE:-/etc/hostname}"
NETPLAN_DIR="${NETPLAN_DIR:-/etc/netplan}"
REL="${1:-}"

case "$REL" in
  config.json|conf.d/bridge.conf|network) ;;
  *) echo "file not allowed: $REL" >&2; exit 2 ;;
esac

# Without the overlay there is nothing to do
if [ "${BROKER_PERSIST_FORCE:-0}" != "1" ] && [ "$(findmnt -no FSTYPE / 2>/dev/null)" != "overlay" ]; then
  exit 0
fi

# ---------- source checks (config.json / bridge.conf) ----------
SRC=""; DST=""
if [ "$REL" != "network" ]; then
  [ -d "$LOWER$BROKER" ] || { logger -t broker-persist "ERROR: $LOWER$BROKER does not exist"; exit 3; }
  SRC="$BROKER/$REL"
  DST="$LOWER$BROKER/$REL"
  # SECURITY: the helper runs as root, so refuse symlinks and paths outside the broker folder
  [ -f "$SRC" ] && [ ! -L "$SRC" ] || { logger -t broker-persist "REFUSED: $SRC is not a regular file"; exit 4; }
  RP="$(realpath "$SRC")"; BP="$(realpath -m "$BROKER")"
  case "$RP" in "$BP"/*) ;; *) logger -t broker-persist "REFUSED: $RP is outside $BP"; exit 4 ;; esac
fi

exec 9>/run/broker-persist.lock
flock 9

# ---------- eth0 YAML checker ----------
# exit 0 = valid YAML that defines eth0 | 1 = not eth0 (e.g. wifi) | 2 = invalid / half-written YAML
eth0_check() {
  python3 -I -c '
import sys, re
t = open(sys.argv[1]).read()
try:
    import yaml
except ImportError:
    ok = re.search(r"(?m)^\s*ethernets:", t) and re.search(r"\beth0\b", t)
    sys.exit(0 if ok else 1)
try:
    d = yaml.safe_load(t)
except Exception:
    sys.exit(2)
if not isinstance(d, dict):
    sys.exit(2)
eth = ((d.get("network") or {}).get("ethernets")) or {}
for k, v in eth.items():
    v = v or {}
    m = (v.get("match") or {}).get("name")
    nm = (v.get("networkmanager") or {}).get("name")
    if k == "eth0" or m == "eth0" or nm == "netplan-eth0":
        sys.exit(0)
sys.exit(1)
' "$1" 2>/dev/null
}

# ---------- network profile sync plan ----------
DO_NET=0
case "$REL" in network|conf.d/bridge.conf) DO_NET=1 ;; esac
NET_COPY=(); NET_DEL=(); UPFILES=()
if [ "$DO_NET" = 1 ]; then
  if [ ! -d "$LOWER$NETPLAN_DIR" ] || [ ! -d "$NETPLAN_DIR" ]; then
    logger -t broker-persist "ERROR: netplan folder not found ($NETPLAN_DIR)"
    DO_NET=0
    [ "$REL" = "network" ] && exit 3
  fi
fi
if [ "$DO_NET" = 1 ]; then
  shopt -s nullglob
  BADYAML=0
  for f in "$NETPLAN_DIR"/*.yaml; do
    eth0_check "$f"; rc=$?
    if [ $rc = 0 ]; then UPFILES+=("$f"); elif [ $rc = 2 ]; then BADYAML=1; fi
  done
  # No eth0 YAML, or one is half-written -> touch nothing (the timer will retry)
  if [ ${#UPFILES[@]} -eq 0 ] || [ $BADYAML = 1 ]; then DO_NET=0; fi
fi
if [ "$DO_NET" = 1 ]; then
  for f in "${UPFILES[@]}"; do
    b="$(basename "$f")"
    cmp -s "$f" "$LOWER$NETPLAN_DIR/$b" || NET_COPY+=("$f")
  done
  # eth0 YAML on the real SD that no longer exists in the overlay view (renamed / deleted by NetworkManager)
  for f in "$LOWER$NETPLAN_DIR"/*.yaml; do
    eth0_check "$f"; [ $? = 0 ] || continue
    b="$(basename "$f")"
    [ -f "$NETPLAN_DIR/$b" ] || NET_DEL+=("$f")
  done
fi

# ---------- file sync plan ----------
NEED_FILE=0; NEED_HOST=0
if [ "$REL" != "network" ]; then
  cmp -s "$SRC" "$DST" || NEED_FILE=1
  if [ "$REL" = "conf.d/bridge.conf" ] && [ -f "$HOSTNAME_FILE" ]; then
    cmp -s "$HOSTNAME_FILE" "$LOWER/etc/hostname" || NEED_HOST=1
  fi
fi
if [ "$NEED_FILE" = 0 ] && [ "$NEED_HOST" = 0 ] && [ ${#NET_COPY[@]} -eq 0 ] && [ ${#NET_DEL[@]} -eq 0 ]; then
  exit 0
fi

remount_ro() { [ "${BROKER_PERSIST_NOMOUNT:-0}" = "1" ] || mount -o remount,ro "$LOWER"; }
if [ "${BROKER_PERSIST_NOMOUNT:-0}" != "1" ]; then
  mount -o remount,rw "$LOWER" || { logger -t broker-persist "ERROR: remount rw failed"; exit 6; }
fi
trap remount_ro EXIT

put() {   # put <source> <destination>  -> atomic write on the real SD card
  local s="$1" d="$2" t="$2.tmp.$$"
  cp -P "$s" "$t" || return 1
  # the copy must be a regular file (not a symlink) and its content must be valid - checked on the COPY
  if [ ! -f "$t" ] || [ -L "$t" ]; then rm -f "$t"; logger -t broker-persist "REFUSED: copy is not a regular file"; return 1; fi
  case "$d" in
    *.json) python3 -I -c 'import json,sys; json.load(open(sys.argv[1]))' "$t" 2>/dev/null || { rm -f "$t"; logger -t broker-persist "ERROR: not valid JSON"; return 1; } ;;
    *.yaml) eth0_check "$t" || { rm -f "$t"; logger -t broker-persist "ERROR: not a valid eth0 YAML"; return 1; } ;;
  esac
  if [ -e "$d" ]; then
    chown --reference="$d" "$t"; chmod --reference="$d" "$t"
  else
    case "$d" in *.yaml) chown root:root "$t"; chmod 600 "$t" ;; esac
  fi
  sync "$t"
  mv -f "$t" "$d"
  sync -f "$d"
}

RC=0
[ "$NEED_FILE" = 1 ] && { put "$SRC" "$DST" || RC=7; }
[ "$NEED_HOST" = 1 ] && { put "$HOSTNAME_FILE" "$LOWER/etc/hostname" || RC=8; }
for f in "${NET_COPY[@]+"${NET_COPY[@]}"}"; do
  put "$f" "$LOWER$NETPLAN_DIR/$(basename "$f")" || RC=9
done
if [ $RC -ne 9 ]; then   # delete old YAML only if every new copy succeeded
  for f in "${NET_DEL[@]+"${NET_DEL[@]}"}"; do
    rm -f "$f" && sync -f "$LOWER$NETPLAN_DIR" || RC=9
  done
fi
logger -t broker-persist "persisted $REL (file=$NEED_FILE hostname=$NEED_HOST net_copy=${#NET_COPY[@]} net_del=${#NET_DEL[@]} rc=$RC)"
exit $RC
